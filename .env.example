DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Server-only admin authentication. Never expose these with a NEXT_PUBLIC_ prefix.
ADMIN_SESSION_SECRET="replace-with-at-least-32-random-characters"

# One-time local bootstrap values used only by `npm run db:seed-admin`.
# Remove them from runtime environments after the initial SUPER_ADMIN is created.
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD="replace-with-a-strong-password"
