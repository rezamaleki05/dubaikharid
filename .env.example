# Runtime PostgreSQL connection. Use a Neon pooled endpoint on Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=verify-full"

# Migration-only PostgreSQL connection. Use the matching Neon direct endpoint.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=verify-full"

# Customer authentication. NEXTAUTH_URL must match each environment URL.
NEXTAUTH_SECRET="replace-with-at-least-32-random-characters"
NEXTAUTH_URL="http://localhost:3000"

# Canonical public website URL. Keep this on the real production HTTPS domain,
# including in Preview, so canonical metadata never points at vercel.app.
NEXT_PUBLIC_SITE_URL="https://dubaykharid.ir"

# Server-only admin authentication. Never expose these with a NEXT_PUBLIC_ prefix.
ADMIN_SESSION_SECRET="replace-with-at-least-32-random-characters"

# Server-only Vercel Blob token for authenticated Admin product image uploads.
BLOB_READ_WRITE_TOKEN=""

# Dedicated token for a PRIVATE Vercel Blob store used only for payment receipts.
PAYMENT_RECEIPT_BLOB_READ_WRITE_TOKEN=""

# Optional Google OAuth. Configure both or neither.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# One-time local bootstrap values used only by `npm run db:seed-admin`.
# Remove them from runtime environments after the initial SUPER_ADMIN is created.
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD="replace-with-a-strong-password"

# Optional local deployment tooling. Vercel supplies VERCEL_ENV automatically.
DEPLOY_ENV="development"
DEPLOYMENT_URL=""

# Destructive demo seeding remains disabled unless explicitly enabled in a disposable dev DB.
ALLOW_DESTRUCTIVE_DEV_SEED="false"
